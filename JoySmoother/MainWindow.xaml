<Window x:Class="JoySmoother.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JoySmoother"
        Width="860"
        Height="760"
        MinWidth="760"
        MinHeight="680"
        Background="#F3F5F9"
        Foreground="#172033"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderBrush" Value="#DCE2EC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="JoySmoother" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Monitor controller input or smooth stick drift before it reaches a game."
                       Margin="0,4,0,0"
                       Foreground="#596579"
                       FontSize="14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Input controller">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Controller to read"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <ComboBox x:Name="ControllerSelector"
                                      Width="280"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ControllerSlots}"
                                      SelectedIndex="0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="ControllerSelection_SelectionChanged" />
                        </DockPanel>
                        <TextBlock Text="XInput does not provide controller names. Move the left stick on each device and match its live readings below."
                                   TextWrapping="Wrap"
                                   Foreground="#596579"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ControllerSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E7EF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SlotName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ConnectionText}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{Binding ConnectionColor}" />
                                            <TextBlock Text="{Binding AxisText}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="Consolas"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Smoothing parameters">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Drift zone" VerticalAlignment="Center" />
                        <TextBox x:Name="DriftZoneInput" Grid.Row="0" Grid.Column="1"
                                 Text="2621" MaxLength="5"
                                 HorizontalContentAlignment="Right"
                                 TextChanged="ParameterInput_TextChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Range: 0–10000"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#596579" />

                        <TextBlock Grid.Row="1" Text="Velocity cutoff" VerticalAlignment="Center" />
                        <TextBox x:Name="VelocityCutoffInput" Grid.Row="1" Grid.Column="1"
                                 Text="80" MaxLength="4"
                                 HorizontalContentAlignment="Right"
                                 TextChanged="ParameterInput_TextChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Range: 0–1500"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#596579" />

                        <TextBlock Grid.Row="2" Text="Settle delay (frames)" VerticalAlignment="Center" />
                        <TextBox x:Name="SettleDelayInput" Grid.Row="2" Grid.Column="1"
                                 Text="8" MaxLength="2"
                                 HorizontalContentAlignment="Right"
                                 TextChanged="ParameterInput_TextChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Range: 1–60"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#596579" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Output">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Output mode"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <ComboBox x:Name="OutputModeSelector"
                                      Width="280"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Monitor only" />
                                <ComboBoxItem Content="Virtual Xbox 360 controller" />
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="Virtual mode sends the filtered left stick to a virtual Xbox controller. Games should use that virtual controller as their input."
                                   TextWrapping="Wrap"
                                   Foreground="#596579" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Selected controller readings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Raw input" Foreground="#596579" />
                            <TextBlock x:Name="RawValuesText" Text="X: 0    Y: 0"
                                       FontFamily="Consolas" FontSize="20" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Smoothed output" Foreground="#596579" />
                            <TextBlock x:Name="SmoothedValuesText" Text="X: 0    Y: 0"
                                       FontFamily="Consolas" FontSize="20" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Text="Ready. Select an input controller and output mode."
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#596579" />
        </DockPanel>
    </Grid>
</Window>
